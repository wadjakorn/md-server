# Copy to .env and fill in. Every value is host-specific; none are committed.

# Directory to serve, read-only.
DOCS_DIR=${HOME}/development

# This machine's Tailscale address. Leave unset to bind loopback only.
# TAILSCALE_IP=100.x.y.z

# Address this box's own hostname resolves to (Debian/Ubuntu: 127.0.1.1).
LOCAL_HOST_IP=127.0.1.1

TZ=UTC
